{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/gen",
      "!**/node_modules",
      "!**/.next",
      "!**/.open-next",
      "!**/.sst",
      "!backend",
      "!vault",
      "!.changeset",
      "!**/tokens.generated.css",
      "!packages/ui/artifact",
      "!**/*.tsbuildinfo",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/chart.tsx"],
      "linter": {
        "rules": {
          "security": { "noDangerouslySetInnerHtml": "off" },
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    }
  ]
}
