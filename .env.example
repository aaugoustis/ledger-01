# Copy to .env (gitignored). Taskfile loads it for every task.

# development | production
APP_ENV=development
# Public origin of the web app; drives the OAuth redirect URL and cookie security.
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# --- Go API ---
# Loopback only: Next.js reaches the API on localhost, and on Windows it avoids a firewall prompt
# on every `go run` (each build is a new executable). Use :8080 to expose it on your network.
API_ADDR=127.0.0.1:8080
# Where Next.js reaches the API (rewrites + server-side Connect calls).
API_INTERNAL_URL=http://127.0.0.1:8080
# Path prefix to strip when the API sits behind a gateway stage or CloudFront path (empty locally).
API_BASE_PATH=

# --- Database (matches docker-compose.yml) ---
DB_PORT=5432
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
# Keep small: on Lambda every concurrent instance opens its own pool.
DB_MAX_CONNS=4

# --- Auth ---
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=you@example.com
SESSION_TTL=720h
# Dev-only email login for Playwright. Ignored unless APP_ENV=development.
AUTH_DEV_LOGIN=0
